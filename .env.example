# ============================================================
# Klinik AI Asistan - Ortam Değişkeni Şablonu
#
# Bu dosya ÖRNEKTİR ve depoya girer (gerçek değer içermez).
# Kullanmak için kopyalayın:   cp .env.example .env
# .env dosyası .gitignore ile depo dışında tutulur.
# ============================================================

# Arayüze tarayıcı üzerinden izin verilecek dış kaynaklar (CORS).
# Virgülle ayrılır. Boş bırakılırsa API dışarıya tamamen kapalıdır
# (arayüz aynı sunucudan sunulduğu için normal kullanımda boş kalmalıdır).
#
# Örnek:
# ALLOWED_ORIGINS=https://klinik.ornek.com,https://www.klinik.ornek.com
ALLOWED_ORIGINS=

# ------------------------------------------------------------
# Yönetici kimlik bilgileri (HTTP Basic Auth).
#
# Bu kimlik YALNIZCA hasta verisi döndüren uçları korur:
#   Sayfalar : /gecmis  /geribildirim
#   API'ler  : /kayitlar  /istatistik  /geribildirim_listesi  /pdf-indir
#
# Herkese açık (demo akışı): /  /bilgi  /egitim  /model_metrikleri
#                            POST /tahmin  POST /geribildirim
#
# ADMIN_SIFRE boş bırakılırsa sabit bir varsayılana DÜŞÜLMEZ; sunucu her
# açılışta rastgele geçici bir şifre üretip terminale yazar. Kalıcı bir
# şifre için aşağıya güçlü bir değer girin.
#
# Güçlü şifre üretmek için:
#     python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# BULUTA ÇIKMADAN ÖNCE mutlaka HTTPS kullanın; Basic Auth şifreyi
# yalnızca Base64 ile kodlar, şifrelemez.
# ------------------------------------------------------------
ADMIN_KULLANICI=admin
ADMIN_SIFRE=

# ------------------------------------------------------------
# PDF indirme jetonu (kısa ömürlü, imzalı erişim bağlantısı).
#
# Herkese açık analiz akışında ziyaretçi, /tahmin yanıtıyla gelen jetonla
# YALNIZCA kendi ürettiği raporu indirebilir. Jeton hasta_id'ye bağlıdır;
# başka bir kaydın raporunu açmaz (IDOR koruması).
#
# PDF_JETON_ANAHTARI tanımlanmazsa her açılışta rastgele üretilir ve sunucu
# yeniden başladığında dağıtılmış jetonlar geçersizleşir. Birden fazla
# worker/kopya ile çalışıyorsanız SABİT bir değer ZORUNLUDUR; aksi halde
# her worker farklı anahtar üretir ve jetonlar rastgele reddedilir.
#
# Anahtar üretmek için:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# ------------------------------------------------------------
PDF_JETON_ANAHTARI=
PDF_JETON_OMRU_SN=600

# ------------------------------------------------------------
# Hız sınırları (IP başına). Biçim: "<adet>/<süre>", ör. 5/minute.
#
# Hepsi isteğe bağlıdır; tanımlanmazsa aşağıdaki varsayılanlar geçerlidir.
# Değerler main.py'de değil BURADA ayarlanır, böylece sunucuyu yeniden
# başlatmak dışında kod değişikliği gerekmez.
#
#   SINIR_YAZMA  POST /tahmin ve POST /geribildirim. Bir hekim dakikada
#                beşten fazla muayene kaydetmez; bu eşik otomatik
#                betiklerin veritabanını doldurmasını engeller.
#   SINIR_OKUMA  Sayfalar ve listeleme uçları. Yazma eşiği burada
#                arayüzü kırardı: /gecmis açılışta iki istek atar ve her
#                sayfalama tıklaması bir istek daha üretir.
#   SINIR_PDF    PDF üretimi CPU maliyetlidir, ayrı ve daha dar tutulur.
#   SINIR_GIRIS  YALNIZCA BAŞARISIZ giriş denemelerini sayar. Doğru
#                şifreyle çalışan personel hiçbir zaman engellenmez.
# ------------------------------------------------------------
SINIR_YAZMA=5/minute
SINIR_OKUMA=60/minute
SINIR_PDF=20/minute
SINIR_GIRIS=5/minute

# ------------------------------------------------------------
# Sunucu bağlama ayarları.
# Bulut platformları (Render, Railway, Heroku) PORT değişkenini
# kendisi atar; genellikle elle tanımlamanız gerekmez.
# ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------
# PDF rapor künyesi.
# İndirilen klinik raporun sayfa başlığında yer alır. Tanımlanmazsa
# genel bir başlık ("SAĞLIK KURULUŞU") basılır; kendi kurumunuzun
# adını buraya yazın.
# ------------------------------------------------------------
KURUM_ADI=SAĞLIK KURULUŞU
KURUM_BIRIM=Kardiyoloji Birimi · Klinik Karar Destek Sistemi
