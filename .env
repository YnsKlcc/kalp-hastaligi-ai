# ============================================================
# Klinik AI Asistan - YEREL ORTAM DEĞİŞKENLERİ
#
# BU DOSYA GİZLİDİR. .gitignore ile depo dışında tutulur;
# asla commit etmeyin, paylaşmayın veya ekran görüntüsüne almayın.
# Şablon için .env.example dosyasına bakın.
# ============================================================

# Dış kaynaklara CORS izni. Arayüz aynı sunucudan sunulduğu için
# boş kalmalıdır (boş = API dışarıya tamamen kapalı).
ALLOWED_ORIGINS=

# ------------------------------------------------------------
# Yönetici kimlik bilgileri (HTTP Basic Auth).
# Şifre secrets.token_urlsafe(24) ile rastgele üretilmiştir.
# Değiştirmek isterseniz aşağıdaki satırı düzenleyip sunucuyu
# yeniden başlatmanız yeterlidir.
# ------------------------------------------------------------
ADMIN_KULLANICI=admin
ADMIN_SIFRE=Admin2026?.

# ------------------------------------------------------------
# Sunucu bağlama ayarları. Bulut platformları (Render, Railway,
# Heroku) PORT değişkenini kendisi atar.
# ------------------------------------------------------------
# PDF indirme jetonu imzalama anahtari (sabit -> sunucu yeniden
# baslasa da dagitilmis jetonlar gecerli kalir).
PDF_JETON_ANAHTARI=P874dmfa5k98HGsVYjeLHqwl4QG28FFPI2m7hJE0H6w
PDF_JETON_OMRU_SN=600

HOST=0.0.0.0
PORT=8000
